#!/usr/bin/env python3
"""A stand-in for `make`: records the call to $FAKE_MAKE_LOG and exits 0.

The plugin's claim is that its sync provider runs `make sync` in the repo root, not that the host's make
works (it shells out to Xcode on macOS, and dies on a stale SDKROOT). So nothing is built here."""
import json
import os
import sys

with open(os.environ["FAKE_MAKE_LOG"], "a") as f:
    f.write(json.dumps({"args": sys.argv[1:], "cwd": os.getcwd()}) + "\n")
